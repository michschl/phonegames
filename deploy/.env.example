# Wird vom Deploy-Workflow automatisch geschrieben (siehe docs/DEPLOYMENT.md).
# Nur für manuelles Deployment von Hand anlegen.
APP_IMAGE=ghcr.io/michschl/phonegames:latest
# Erzählstimme (Piper), Tag = Prüfsumme des Ordners tts/ (siehe deploy.yml)
TTS_IMAGE=ghcr.io/michschl/phonegames-tts:<tag>
APP_DOMAIN=phonegames.example.ch
APP_VERSION=manual
# Einladungscodes für die Registrierung, mit Komma getrennt. Leer = Registrierung für alle offen.
INVITE_CODES=
