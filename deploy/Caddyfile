# Caddy fetches and renews the Let's Encrypt certificate automatically.
{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	reverse_proxy app:3000
}

# Further domains (e.g. phonegames.ch) redirect permanently to the main address,
# so the app, its logins, passkeys and the installed PWA live on one origin.
# Without REDIRECT_DOMAINS this is a harmless placeholder (see docker-compose.yml).
{$REDIRECT_DOMAINS} {
	redir https://{$APP_DOMAIN}{uri} permanent
}
