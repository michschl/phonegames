{
  "name": "phonegames",
  "version": "1.0.0",
  "private": true,
  "description": "Phonegames – Partyspiele fürs Handy. Offline-fähige PWA mit Konten, Spielgruppen und 17 Spielen.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --watch --disable-warning=ExperimentalWarning server/src/index.ts",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/src/index.ts",
    "preview": "npm run build && NODE_ENV=production npm start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vite build && playwright test",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.11",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@playwright/test": "1.63.0",
    "@simplewebauthn/browser": "14.0.0",
    "@types/node": "24.19.2",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "pdfmake": "^0.3.15",
    "playwright-core": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1",
    "zustand": "5.0.16"
  }
}
